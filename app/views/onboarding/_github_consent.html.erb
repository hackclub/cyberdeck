<%# A hand-built recreation of GitHub's OAuth authorization screen.

    Purely decorative: it shows the participant what the next page looks like
    before they leave for github.com. No images, no scripts, no form controls —
    just markup and inline SVG, so it costs a few kilobytes instead of a
    screenshot. Every class is namespaced under .gh-consent; the styles live in
    app/assets/stylesheets/github_consent.css.

    Icon paths are Octicons lifted from a saved copy of the real page, except
    the Octocat (mark-github) and the Hack Club flag, which are noted inline. %>
<div class="gh-consent">
  <p class="gh-consent__sr">
    A preview of GitHub's authorization screen: it asks you to authorize
    “cyberdeck development”, lists the access it wants — manage codespaces,
    public repositories, and read-only access to your email addresses and
    profile — and offers Cancel and Authorize buttons.
  </p>

  <div class="gh-consent__ui" aria-hidden="true">

    <%# ---- the two badges joined by a dashed line ---- %>
    <div class="ghc-connect">
      <span class="ghc-badge ghc-badge--app">
        <%# Hack Club flag, drawn here — the real page uses a generated identicon image. %>
        <svg viewBox="0 0 120 120" class="ghc-badge__glyph">
          <path d="M45 34v52M45 38h30l-6 10 6 10H45" fill="none" stroke="currentColor"
                stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <span class="ghc-tick">
        <svg viewBox="0 0 16 16"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
      </span>

      <span class="ghc-badge ghc-badge--gh">
        <%# octicon mark-github-16 %>
        <svg viewBox="0 0 16 16" class="ghc-badge__glyph"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A8.013 8.013 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
      </span>
    </div>

    <p class="ghc-title">Authorize cyberdeck development</p>

    <%# ---- the consent card ---- %>
    <div class="ghc-card">
      <div class="ghc-card__body">

        <div class="ghc-app">
          <span class="ghc-app__avatar">A</span>
          <span class="ghc-app__name"><b>cyberdeck development</b> by <span class="ghc-link">Armand</span></span>
          <span class="ghc-app__sub">wants to access your <b>NanoMars</b> account</span>
        </div>

        <%# octicon codespaces-24 %>
        <div class="ghc-perm">
          <svg class="ghc-perm__icon" viewBox="0 0 24 24"><path d="M3.5 3.75C3.5 2.784 4.284 2 5.25 2h13.5c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 18.75 13H5.25a1.75 1.75 0 0 1-1.75-1.75Zm-2 12c0-.966.784-1.75 1.75-1.75h17.5c.966 0 1.75.784 1.75 1.75v4a1.75 1.75 0 0 1-1.75 1.75H3.25a1.75 1.75 0 0 1-1.75-1.75ZM5.25 3.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h13.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Zm-2 12a.25.25 0 0 0-.25.25v4c0 .138.112.25.25.25h17.5a.25.25 0 0 0 .25-.25v-4a.25.25 0 0 0-.25-.25Z"/><path d="M10 17.75a.75.75 0 0 1 .75-.75h6.5a.75.75 0 0 1 0 1.5h-6.5a.75.75 0 0 1-.75-.75Zm-4 0a.75.75 0 0 1 .75-.75h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1-.75-.75Z"/></svg>
          <span class="ghc-perm__text">
            <b>Codespace</b>
            <small>Manage codespaces</small>
          </span>
          <svg class="ghc-perm__chevron" viewBox="0 0 24 24"><path d="M5.22 8.22a.749.749 0 0 0 0 1.06l6.25 6.25a.749.749 0 0 0 1.06 0l6.25-6.25a.749.749 0 1 0-1.06-1.06L12 13.939 6.28 8.22a.749.749 0 0 0-1.06 0Z"/></svg>
        </div>

        <%# octicon repo-24 %>
        <div class="ghc-perm">
          <svg class="ghc-perm__icon" viewBox="0 0 24 24"><path d="M3 2.75A2.75 2.75 0 0 1 5.75 0h14.5a.75.75 0 0 1 .75.75v20.5a.75.75 0 0 1-.75.75h-6a.75.75 0 0 1 0-1.5h5.25v-4H6A1.5 1.5 0 0 0 4.5 18v.75c0 .716.43 1.334 1.05 1.605a.75.75 0 0 1-.6 1.374A3.251 3.251 0 0 1 3 18.75ZM19.5 1.5H5.75c-.69 0-1.25.56-1.25 1.25v12.651A2.989 2.989 0 0 1 6 15h13.5Z"/><path d="M7 18.25a.25.25 0 0 1 .25-.25h5a.25.25 0 0 1 .25.25v5.01a.25.25 0 0 1-.397.201l-2.206-1.604a.25.25 0 0 0-.294 0L7.397 23.46a.25.25 0 0 1-.397-.2v-5.01Z"/></svg>
          <span class="ghc-perm__text">
            <b>Repositories</b>
            <small>Public repositories</small>
          </span>
          <svg class="ghc-perm__chevron" viewBox="0 0 24 24"><path d="M5.22 8.22a.749.749 0 0 0 0 1.06l6.25 6.25a.749.749 0 0 0 1.06 0l6.25-6.25a.749.749 0 1 0-1.06-1.06L12 13.939 6.28 8.22a.749.749 0 0 0-1.06 0Z"/></svg>
        </div>

        <%# octicon person-24 %>
        <div class="ghc-perm">
          <svg class="ghc-perm__icon" viewBox="0 0 24 24"><path d="M12 2.5a5.5 5.5 0 0 1 3.096 10.047 9.005 9.005 0 0 1 5.9 8.181.75.75 0 1 1-1.499.044 7.5 7.5 0 0 0-14.993 0 .75.75 0 0 1-1.5-.045 9.005 9.005 0 0 1 5.9-8.18A5.5 5.5 0 0 1 12 2.5ZM8 8a4 4 0 1 0 8 0 4 4 0 0 0-8 0Z"/></svg>
          <span class="ghc-perm__text">
            <b>Personal user data</b>
            <small>Email addresses (read-only), profile information (read-only)</small>
          </span>
          <svg class="ghc-perm__chevron" viewBox="0 0 24 24"><path d="M5.22 8.22a.749.749 0 0 0 0 1.06l6.25 6.25a.749.749 0 0 0 1.06 0l6.25-6.25a.749.749 0 1 0-1.06-1.06L12 13.939 6.28 8.22a.749.749 0 0 0-1.06 0Z"/></svg>
        </div>

        <p class="ghc-orgs__title">Organization access</p>

        <div class="ghc-org">
          <span class="ghc-org__avatar ghc-org__avatar--hc">h</span>
          <span class="ghc-org__name">hackclub</span>
          <%# octicon check-16 %>
          <svg class="ghc-org__state ghc-org__state--ok" viewBox="0 0 16 16"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
        </div>

      </div>

      <div class="ghc-card__footer">
        <div class="ghc-actions">
          <span class="ghc-btn">Cancel</span>
          <span class="ghc-btn ghc-btn--primary">Authorize NanoMars</span>
        </div>
        <p class="ghc-redirect">
          Authorizing will redirect to<br>
          <b>http://localhost:3000</b>
        </p>
      </div>
    </div>

    <%# ---- the three facts below the card ---- %>
    <div class="ghc-facts">
      <%# octicon circle-slash-16 %>
      <span class="ghc-fact">
        <svg viewBox="0 0 16 16"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM3.965 13.096a6.5 6.5 0 0 0 9.131-9.131ZM1.5 8a6.474 6.474 0 0 0 1.404 4.035l9.131-9.131A6.499 6.499 0 0 0 1.5 8Z"/></svg>
        <b>Not</b> owned or operated by GitHub
      </span>
      <%# octicon clock-16 %>
      <span class="ghc-fact">
        <svg viewBox="0 0 16 16"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm7-3.25v2.992l2.028.812a.75.75 0 0 1-.557 1.392l-2.5-1A.751.751 0 0 1 7 8.25v-3.5a.75.75 0 0 1 1.5 0Z"/></svg>
        Created <b>less than a day ago</b>
      </span>
      <%# octicon organization-16 %>
      <span class="ghc-fact">
        <svg viewBox="0 0 16 16"><path d="M1.75 16A1.75 1.75 0 0 1 0 14.25V1.75C0 .784.784 0 1.75 0h8.5C11.216 0 12 .784 12 1.75v12.5c0 .085-.006.168-.018.25h2.268a.25.25 0 0 0 .25-.25V8.285a.25.25 0 0 0-.111-.208l-1.055-.703a.749.749 0 1 1 .832-1.248l1.055.703c.487.325.779.871.779 1.456v5.965A1.75 1.75 0 0 1 14.25 16h-3.5a.766.766 0 0 1-.197-.026c-.099.017-.2.026-.303.026h-3a.75.75 0 0 1-.75-.75V14h-1v1.25a.75.75 0 0 1-.75.75Zm-.25-1.75c0 .138.112.25.25.25H4v-1.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 .75.75v1.25h2.25a.25.25 0 0 0 .25-.25V1.75a.25.25 0 0 0-.25-.25h-8.5a.25.25 0 0 0-.25.25ZM3.75 6h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1 0-1.5ZM3 3.75A.75.75 0 0 1 3.75 3h.5a.75.75 0 0 1 0 1.5h-.5A.75.75 0 0 1 3 3.75Zm4 3A.75.75 0 0 1 7.75 6h.5a.75.75 0 0 1 0 1.5h-.5A.75.75 0 0 1 7 6.75ZM7.75 3h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1 0-1.5ZM3 9.75A.75.75 0 0 1 3.75 9h.5a.75.75 0 0 1 0 1.5h-.5A.75.75 0 0 1 3 9.75ZM7.75 9h.5a.75.75 0 0 1 0 1.5h-.5a.75.75 0 0 1 0-1.5Z"/></svg>
        <b>Fewer than 10</b> GitHub users
      </span>
    </div>
  </div>
</div>
